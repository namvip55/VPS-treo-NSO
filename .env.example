# ==============================================================================
# FILE MẪU CẤU HÌNH BÍ MẬT (KHÔNG CHỨA TOKEN THẬT - AN TOÀN ĐỂ COMMIT GIT)
# Để sử dụng: Tạo file '.env' cùng thư mục và điền giá trị thật của bạn vào.
# File '.env' đã được chặn trong .gitignore, tuyệt đối không bị commit lên GitHub.
# ==============================================================================

# Ngrok Authtoken cá nhân (Lấy từ dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Tên miền tĩnh Ngrok (Ví dụ: mistily-stipular-kristopher.ngrok-free.dev)
NGROK_DOMAIN=mistily-stipular-kristopher.ngrok-free.dev
